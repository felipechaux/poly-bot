# ============================================================
# Invest Bot — variables de entorno. Copia a .env (nunca lo subas a git).
# El resto de la configuración está en config/default.yaml
# ============================================================

# Solo "paper" en la Fase 1
POLY_MODE=paper

# --- Notificaciones al iPhone (ntfy.sh) ---
# 1) Instala la app "ntfy" en el iPhone  2) suscríbete al mismo topic.
# El topic funciona como contraseña: usa uno largo y aleatorio, ej.:
#   python3 -c "import secrets; print('invest-' + secrets.token_urlsafe(16))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # solo si usas un servidor ntfy con autenticación

# URL que abre la notificación al tocarla (ej. Cloudflare Tunnel)
# DASHBOARD_URL=https://invest.example.com

# Si se define, ejecutar un ciclo por API (POST /api/cycle?dry_run=false) exige "Authorization: Bearer <token>"
# ADMIN_TOKEN=

# --- Analista Claude (suscripción, SIN API key) ---
# Recomendado: login interactivo una vez dentro del contenedor (sin variables):
#   docker compose exec -it invest-bot claude   → /login
# La sesión queda en el volumen claude_auth y sobrevive a los deploys.
# Alternativa: token de larga duración generado en la Mac con `claude setup-token`.
# Nunca pongas ANTHROPIC_API_KEY aquí: el bot la ignora a propósito.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Binance Spot Testnet (dinero falso) ---
# Crea las llaves en https://testnet.binance.vision (login con GitHub → Generate HMAC_SHA256 Key).
# Sin llaves, las órdenes cripto siguen 100% simuladas. Prueba: poly-bot binance
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# --- Logging ---
LOG_FORMAT=console
LOG_LEVEL=INFO
